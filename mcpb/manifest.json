{
  "manifest_version": "0.3",
  "name": "gittr-mcp",
  "display_name": "gittr — Git on Nostr",
  "version": "1.0.4",
  "description": "Use gittr.space from Claude: repos, push, issues, PRs, stars, bounties, private repos. Nostr identity (NIP-34).",
  "long_description": "Connect your AI to [gittr.space](https://gittr.space) — decentralized git on Nostr. Create repos, push code, manage issues and pull requests, stars, Lightning bounties, and private repositories using your Nostr keys (not a GitHub login).",
  "author": {
    "name": "SatOpsHQ",
    "url": "https://github.com/arbadacarbaYK"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arbadacarbaYK/gittr-mcp.git"
  },
  "homepage": "https://gittr.space",
  "documentation": "https://github.com/arbadacarbaYK/gittr-mcp#readme",
  "support": "https://github.com/arbadacarbaYK/gittr-mcp/issues",
  "server": {
    "type": "node",
    "entry_point": "server.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/server.js"
      ],
      "env": {
        "BRIDGE_URL": "${user_config.bridge_url}"
      }
    }
  },
  "user_config": {
    "bridge_url": {
      "type": "string",
      "title": "gittr bridge URL",
      "description": "gittr API origin (default https://gittr.space)",
      "default": "https://gittr.space",
      "required": false
    }
  }
}
